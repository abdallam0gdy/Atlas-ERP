# ============================================
# Atlas ERP — Server Environment Template
# ============================================

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL (Local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atlas_erp_local
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Authentication
JWT_SECRET=replace_with_a_secure_jwt_secret_key
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Future Online Sync
SYNC_ENABLED=false
SYNC_REMOTE_URL=
