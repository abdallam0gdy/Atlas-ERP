# ============================================================
# Atlas Educational ERP — Client Environment Variables Template
# ============================================================
# عند الرفع على Cloudflare Pages أو Vercel:
# أضف هذه المتغيرات في لوحة التحكم (Settings -> Environment variables)
# ============================================================

# Supabase Online Database
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# ImgBB API Key for Uploading Photos & Logos
VITE_IMGBB_API_KEY=your_imgbb_api_key

# Backend Express API Base URL (leave /api for local dev proxy or specify backend URL)
VITE_API_BASE_URL=/api
